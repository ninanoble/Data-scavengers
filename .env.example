# GEMINI_API_KEY: Required for server-side Gemini AI insights and qualitative theme suggestions.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_TIMEOUT_MINUTES: Automatic client inactivity lock/timeout in minutes (default 30).
VITE_SESSION_TIMEOUT_MINUTES="30"
